# Copia este archivo a .env y rellénalo con la config web de tu proyecto Firebase.
# Sin estas variables la app funciona igual, pero guarda los libros solo en este navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave de Google Books (solo Books API, restringida a la web y localhost)
VITE_GOOGLE_BOOKS_API_KEY=
