rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth.token.email;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function memberPath() {
      return /databases/$(database)/documents/allowedUsers/$(signedInEmail());
    }

    function isAdmin() {
      return exists(memberPath()) && get(memberPath()).data.get('admin', false) == true;
    }

    function isLibrary(id) {
      return isAdmin() || (exists(memberPath())
        ? id == get(memberPath()).data.get('library', signedInEmail())
        : id == signedInEmail());
    }

    match /allowedUsers/{email} {
      allow read: if isSignedIn() && email == signedInEmail();
    }

    match /books/{bookId} {
      allow read, delete: if isSignedIn() && isLibrary(resource.data.owner);
      allow create: if isSignedIn() && isLibrary(request.resource.data.owner);
      allow update: if isSignedIn() && isLibrary(resource.data.owner) && isLibrary(request.resource.data.owner);
    }

    match /libraries/{library} {
      allow read, write: if isSignedIn() && isLibrary(library);
    }
  }
}
