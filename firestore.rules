rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth.token.email;
    }

    function isAllowed() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedUsers/$(signedInEmail()));
    }

    function isOwner(data) {
      return data.owner == signedInEmail();
    }

    match /books/{bookId} {
      allow read, delete: if isAllowed() && isOwner(resource.data);
      allow create: if isAllowed() && isOwner(request.resource.data);
      allow update: if isAllowed() && isOwner(resource.data) && isOwner(request.resource.data);
    }

    match /libraries/{email} {
      allow read, write: if isAllowed() && email == signedInEmail();
    }
  }
}
