rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth.token.email;
    }

    function memberPath() {
      return /databases/$(database)/documents/allowedUsers/$(signedInEmail());
    }

    function isAllowed() {
      return request.auth != null && exists(memberPath());
    }

    function libraryId() {
      return get(memberPath()).data.get('library', signedInEmail());
    }

    function isOwner(data) {
      return data.owner == libraryId();
    }

    match /allowedUsers/{email} {
      allow read: if request.auth != null && email == signedInEmail();
    }

    match /books/{bookId} {
      allow read, delete: if isAllowed() && isOwner(resource.data);
      allow create: if isAllowed() && isOwner(request.resource.data);
      allow update: if isAllowed() && isOwner(resource.data) && isOwner(request.resource.data);
    }

    match /libraries/{library} {
      allow read, write: if isAllowed() && library == libraryId();
    }
  }
}
